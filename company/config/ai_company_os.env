# AI Company OS master autonomous mode defaults.
# Runtime ON/OFF state lives in company/runtime/ai-company-os/state.env.

AI_COMPANY_OS_ENABLED=0
AI_COMPANY_AUTOSOLVE_ENABLED=1
AI_COMPANY_CLIENT_PRIORITY=1
AI_COMPANY_INTERNAL_IDLE_WORK_ENABLED=1
AI_COMPANY_TIMEZONE=Asia/Jakarta
AI_COMPANY_WORK_START_HOUR=07
AI_COMPANY_WORK_END_HOUR=17
AI_COMPANY_OVERTIME_ENABLED=1
AI_COMPANY_OVERTIME_END_HOUR=19
AI_COMPANY_OVERTIME_ALLOW_NEW_DISCOVERY=0
AI_COMPANY_OVERTIME_ALLOW_INTERNAL_IMPROVEMENT=0
AI_COMPANY_OVERTIME_ALLOW_QA=1
AI_COMPANY_OVERTIME_ALLOW_REPORTING=1
AI_COMPANY_MAX_AUTONOMOUS_ITERATIONS=1
AI_COMPANY_DISCOVERY_ONLY_AFTER_RESOLUTION=1
