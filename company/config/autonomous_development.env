# AI Company OS autonomous development defaults
# Source this file from runners. Values can be overridden by environment variables.

: "${AI_COMPANY_ENABLE_AUTO_EDIT:=0}"
: "${AI_COMPANY_ENABLE_AUTO_COMMIT:=0}"
: "${AI_COMPANY_AUTO_PUSH:=0}"
: "${AI_COMPANY_AUTO_MARK_DONE:=0}"

: "${AI_COMPANY_AUTO_BRANCH_PREFIX:=autodev}"
: "${AI_COMPANY_AUTO_MAX_CHANGED_FILES:=25}"
: "${AI_COMPANY_AUTO_MAX_DIFF_LINES:=1800}"

# Infrastructure edits are allowed inside the repo through runners/config/docs/apps.
# Real host-level changes still require explicit shell commands and sudo, not Codex.
: "${AI_COMPANY_ALLOW_REPO_INFRA_EDIT:=1}"

export AI_COMPANY_ENABLE_AUTO_EDIT
export AI_COMPANY_ENABLE_AUTO_COMMIT
export AI_COMPANY_AUTO_PUSH
export AI_COMPANY_AUTO_MARK_DONE
export AI_COMPANY_AUTO_BRANCH_PREFIX
export AI_COMPANY_AUTO_MAX_CHANGED_FILES
export AI_COMPANY_AUTO_MAX_DIFF_LINES
export AI_COMPANY_ALLOW_REPO_INFRA_EDIT
