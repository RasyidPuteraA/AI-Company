# AI Company OS autonomous issue discovery defaults
# Values can be overridden per command.

: "${AI_COMPANY_SELF_DIRECTED_CREATE_TASKS:=0}"
: "${AI_COMPANY_SELF_DIRECTED_AUTO_SOLVE:=0}"
: "${AI_COMPANY_SELF_DIRECTED_MAX_TASKS_PER_RUN:=1}"
: "${AI_COMPANY_SELF_DIRECTED_MIN_SEVERITY:=LOW}"
: "${AI_COMPANY_SELF_DIRECTED_DEFAULT_AGENT:=engineer_agent}"
: "${AI_COMPANY_SELF_DIRECTED_LOOP_INTERVAL:=600}"
: "${AI_COMPANY_SELF_DIRECTED_MAX_ITERATIONS:=3}"

export AI_COMPANY_SELF_DIRECTED_CREATE_TASKS
export AI_COMPANY_SELF_DIRECTED_AUTO_SOLVE
export AI_COMPANY_SELF_DIRECTED_MAX_TASKS_PER_RUN
export AI_COMPANY_SELF_DIRECTED_MIN_SEVERITY
export AI_COMPANY_SELF_DIRECTED_DEFAULT_AGENT
export AI_COMPANY_SELF_DIRECTED_LOOP_INTERVAL
export AI_COMPANY_SELF_DIRECTED_MAX_ITERATIONS
